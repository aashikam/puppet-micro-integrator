[Unit]
Description=WSO2 Micro Integrator Dashboard
After=network.target

[Service]
ExecStart=/bin/sh /usr/local/wso2/<%=@module_name%>/<%=@product_version%>/integration-control-plane-<%=@product_version%>/bin/dashboard.sh start
ExecStop=/bin/sh /usr/local/wso2/<%=@module_name%>/<%=@product_version%>/integration-control-plane-<%=@product_version%>/bin/dashboard.sh stop
ExecReload=/bin/sh /usr/local/wso2/<%=@module_name%>/<%=@product_version%>/integration-control-plane-<%=@product_version%>/bin/dashboard.sh restart
PIDFile=/usr/local/wso2/<%=@module_name%>/<%=@product_version%>/integration-control-plane-<%=@product_version%>/wso2carbon.pid
User=<%=@user%>
Group=<%=@user_group%>
Type=forking
Restart=on-failure
RestartSec=5
StartLimitInterval=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
